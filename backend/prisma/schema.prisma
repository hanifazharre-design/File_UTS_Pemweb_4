datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model CategoryEvent {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  events      Event[]
}

model Pembicara {
  id       Int     @id @default(autoincrement())
  name     String
  biodata  String
  photoUrl String?
  email    String
  events   Event[]
}

model Event {
  id              Int           @id @default(autoincrement())
  title           String
  description     String
  date            String
  location        String
  categoryId      Int
  category        CategoryEvent @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  pembicaraId     Int
  pembicara       Pembicara     @relation(fields: [pembicaraId], references: [id], onDelete: Cascade)
  maxParticipants Int
}

model Pengurus {
  id       Int     @id @default(autoincrement())
  nama     String
  jabatan  String
  photoUrl String?
}
